# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is git-ignored; this example file is committed.

# Database (used by both the Postgres container and the Spring app)
# Host and port as seen from inside docker compose (service "db", internal port).
DATASOURCE_HOST=db
DATASOURCE_PORT=5432
DATASOURCE_NAME=family_recipes
DATASOURCE_USERNAME=family
# Generate one with: openssl rand -hex 16
DATASOURCE_PASSWORD=change-me

# Spring profile for the API container: dev or prod
# (a shell variable overrides it: SPRING_PROFILES_ACTIVE=prod docker compose up -d)
SPRING_PROFILES_ACTIVE=dev
